          <mxGeometry height="82" width="350" x="35" y="65" as="geometry" />
        </mxCell>
        <mxCell id="dct-multi-embed" parent="dct-encode-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#60A5FA;fontColor=#1E3A8A;fontSize=12;" value="&lt;b&gt;多值类别特征&lt;/b&gt;&lt;br&gt;主动兴趣 tags / 命中通道集合&lt;br&gt;Embedding → Sum/Mean Pooling → e_multi" vertex="1">
          <mxGeometry height="82" width="350" x="35" y="175" as="geometry" />
        </mxCell>
        <mxCell id="kTt3A61G966eXll6c2QL-11" edge="1" parent="dct-encode-group" source="dct-dense-encode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="dct-concat" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dct-dense-encode" parent="dct-encode-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#60A5FA;fontColor=#1E3A8A;fontSize=12;" value="&lt;b&gt;连续数值特征&lt;/b&gt;&lt;br&gt;召回分数/排名、发布时间差、冷启动进度&lt;br&gt;+ log1p(exposure/click)、ctr（1d/7d/30d）&lt;br&gt;Log/Clip/Normalize + Missing Mask → x_dense" vertex="1">
          <mxGeometry height="82" width="350" x="35" y="285" as="geometry" />
        </mxCell>
        <mxCell id="dct-concat" parent="dct-encode-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=13;" value="&lt;b&gt;特征拼接&lt;/b&gt;&lt;br&gt;x₀ = Concat(e_sparse, e_multi, x_dense)&lt;br&gt;得到统一稠密输入向量 x₀ ∈ ℝᵈ" vertex="1">
          <mxGeometry height="100" width="350" x="35" y="415" as="geometry" />
        </mxCell>
        <mxCell id="dct-e-enc1" edge="1" parent="dct-encode-group" source="dct-dense-encode" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#3B82F6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="dct-concat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dct-e-input-encode" edge="1" parent="dct-1" source="dct-input-out" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#64748B;strokeWidth=2;fontColor=#334155;" target="dct-encode-group" value="按特征类型路由">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dct-x0" parent="dct-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=14;" value="&lt;b&gt;共享输入向量 x₀&lt;/b&gt;&lt;br&gt;&lt;br&gt;同一份 x₀ 同时送入&lt;br&gt;Cross Network 与 Deep Network" vertex="1">
          <mxGeometry height="160" width="240" x="970" y="315" as="geometry" />
        </mxCell>
        <mxCell id="dct-e-concat-x0" edge="1" parent="dct-1" source="dct-concat" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;" target="dct-x0" value="x₀">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dct-cross" parent="dct-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;" value="&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;③a Cross Network&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;显式特征交叉&lt;/b&gt;&lt;br&gt;xₗ₊₁ = x₀(xₗᵀwₗ) + bₗ + xₗ&lt;br&gt;&lt;br&gt;堆叠 2～4 层 Cross Layer&lt;br&gt;学习 user×item、item×context、channel×category 等有界阶数交叉&lt;br&gt;&lt;br&gt;&lt;b&gt;输出：x_cross&lt;/b&gt;" vertex="1">
          <mxGeometry height="245" width="430" x="1270" y="120" as="geometry" />
        </mxCell>
        <mxCell id="dct-deep" parent="dct-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#14532D;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;" value="&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;③b Deep Network&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;隐式高阶交互&lt;/b&gt;&lt;br&gt;x₀ → Dense(512) → ReLU&lt;br&gt;→ Dense(256) → ReLU&lt;br&gt;→ Dense(128)&lt;br&gt;&lt;br&gt;可选 BatchNorm / Dropout&lt;br&gt;学习非线性高阶组合关系&lt;br&gt;&lt;br&gt;&lt;b&gt;输出：x_deep ∈ ℝ¹²⁸&lt;/b&gt;" vertex="1">
          <mxGeometry height="245" width="430" x="1270" y="450" as="geometry" />
        </mxCell>
        <mxCell id="dct-e-x0-cross" edge="1" parent="dct-1" source="dct-x0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#5B21B6;" target="dct-cross" value="显式交叉">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dct-e-x0-deep" edge="1" parent="dct-1" source="dct-x0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#22C55E;strokeWidth=2;fontColor=#15803D;" target="dct-deep" value="隐式交互">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dct-fusion" parent="dct-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=13;" value="&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;④ 特征融合&lt;/b&gt;&lt;/div&gt;&lt;br&gt;h = Concat(x_cross, x_deep)&lt;br&gt;&lt;br&gt;Fusion MLP：Dense(128) → ReLU → Dense(64)&lt;br&gt;&lt;br&gt;&lt;b&gt;输出：h_fusion ∈ ℝ⁶⁴&lt;/b&gt;" vertex="1">
          <mxGeometry height="195" width="300" x="1760" y="300" as="geometry" />
        </mxCell>
        <mxCell id="dct-e-cross-fuse" edge="1" parent="dct-1" source="dct-cross" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#5B21B6;" target="dct-fusion" value="x_cross">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dct-e-deep-fuse" edge="1" parent="dct-1" source="dct-deep" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#22C55E;strokeWidth=2;fontColor=#15803D;" target="dct-fusion" value="x_deep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dct-head" parent="dct-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;fontSize=13;" value="&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;⑤ 粗排预测头与阶段提权&lt;/b&gt;&lt;/div&gt;&lt;br&gt;基础 coarse_score = calibrated pCTR&lt;br&gt;&lt;br&gt;S0 / S1 / S2 分别读取累计目标12 / 30 / 100，按当前阶段的时间进度与曝光进度计算 dynamic_boost&lt;br&gt;&lt;br&gt;冷：score' = score × boost&lt;br&gt;热：score' = score&lt;br&gt;&lt;b&gt;输出：最终粗排分数&lt;/b&gt;" vertex="1">
          <mxGeometry height="240" width="300" x="2120" y="275" as="geometry" />
        </mxCell>
        <mxCell id="dct-e-fuse-head" edge="1" parent="dct-1" source="dct-fusion" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#F59E0B;strokeWidth=2;fontColor=#92400E;" target="dct-head" value="h_fusion">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dct-output" parent="dct-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=13;" value="&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;⑥ 排序与输出&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;输入：热 / 冷候选粗排分数&lt;/b&gt;&lt;br&gt;&lt;br&gt;按粗排分数降序排序&lt;br&gt;&lt;br&gt;&lt;b&gt;输出：Top-500&lt;/b&gt;&lt;br&gt;满足门槛时尽量保留≥30条冷内容；不足时不强行凑数&lt;br&gt;&lt;br&gt;送入共用 DIN + MMoE 精排" vertex="1">
          <mxGeometry height="240" width="280" x="2480" y="275" as="geometry" />
        </mxCell>
        <mxCell id="dct-e-head-output" edge="1" parent="dct-1" source="dct-head" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#EC4899;strokeWidth=2;fontColor=#9D174D;" target="dct-output" value="合并候选分数">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
