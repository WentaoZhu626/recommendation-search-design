        <mxCell id="offt-title" parent="offt-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#4C1D95;" value="离线训练闭环：双周温启动更新 DIN+MMoE Teacher 与 DCN Student" vertex="1">
          <mxGeometry height="42.49999999999999" width="1400" x="750" y="18.88888888888889" as="geometry" />
        </mxCell>
        <mxCell id="offt-order" parent="offt-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A78BFA;fontColor=#4C1D95;fontSize=14;fontStyle=1;" value="两条分支并行且独立发布：Teacher 用昨日真实反馈更新为 T_N；Student 学习昨日线上 T_{N-1} 已打分的 Top-500，更新为 S_N" vertex="1">
          <mxGeometry height="41.55555555555555" width="1960" x="470" y="68" as="geometry" />
        </mxCell>
        <mxCell id="offt-data" parent="offt-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;① 最近14天两类日志 + 历史回放&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;A. 真实反馈日志&lt;/b&gt;&lt;br&gt;• 曝光、点击、点赞、收藏、评论、停留&lt;br&gt;• 特征截断到曝光时刻；按时间切分Train/Validation&lt;br&gt;&lt;br&gt;&lt;b&gt;B. Teacher打分/蒸馏日志&lt;/b&gt;&lt;br&gt;生产Teacher对DCN Top-500的task logits、final_score、rank和版本&lt;br&gt;&lt;br&gt;&lt;b&gt;历史回放&lt;/b&gt;&lt;br&gt;按时间衰减与长尾类目分层抽样，避免遗忘" vertex="1">
          <mxGeometry height="538.3333333333333" width="360" x="30" y="136.94444444444443" as="geometry" />
        </mxCell>
        <mxCell id="offt-teacher-lane" parent="offt-1" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#F0FDF4;swimlaneFillColor=#FFFFFF;strokeColor=#22C55E;fontColor=#14532D;fontStyle=1;fontSize=15;" value="Teacher 分支：最近14天真实反馈 + 时间衰减历史回放" vertex="1">
          <mxGeometry height="250.27777777777777" width="1960" x="430" y="132.22222222222223" as="geometry" />
        </mxCell>
        <mxCell id="offt-prep" parent="offt-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;②A Teacher 样本准备&lt;/b&gt;&lt;br&gt;去重 / 过滤异常流量&lt;br&gt;曝光前历史序列 + 丰富特征&lt;br&gt;按request_time关联当时可见的Item曝光/点击/CTR日快照&lt;br&gt;Hard Labels：点击、点赞、收藏、评论、停留&lt;br&gt;按时间切分 Train / Validation" vertex="1">
          <mxGeometry height="165.27777777777777" width="410" x="465" y="184.16666666666666" as="geometry" />
        </mxCell>
        <mxCell id="offt-teacher" parent="offt-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;③A 训练 DIN + MMoE：T_N&lt;/b&gt;&lt;br&gt;加载 T_{N-1} 继续训练（固定预算，约 1 epoch + Early Stopping）&lt;br&gt;DIN Attention → MMoE Experts / Gates / Task Towers&lt;br&gt;L_teacher = Σ λₖL_taskₖ&lt;br&gt;分类任务 BCE；停留时长回归损失" vertex="1">
          <mxGeometry height="165.27777777777777" width="500" x="920" y="184.16666666666666" as="geometry" />
        </mxCell>
        <mxCell id="offt-teacher-release" parent="offt-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;④A 验证并独立发布 T_N&lt;/b&gt;&lt;br&gt;AUC / GAUC、LogLoss、各任务指标、概率校准&lt;br&gt;灰度通过后发布 Teacher T_N&lt;br&gt;失败则继续使用 T_{N-1}" vertex="1">
          <mxGeometry height="165.27777777777777" width="430" x="1465" y="184.16666666666666" as="geometry" />
        </mxCell>
        <mxCell id="offt-student-lane" parent="offt-1" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#FFF7ED;swimlaneFillColor=#FFFFFF;strokeColor=#F97316;fontColor=#7C2D12;fontStyle=1;fontSize=15;" value="Student 分支：Teacher更新后离线打分，再蒸馏 DCN（同一双周周期）" vertex="1">
          <mxGeometry height="273.88888888888886" width="1960" x="430" y="401.3888888888889" as="geometry" />
        </mxCell>
        <mxCell id="offt-score" parent="offt-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;②B 蒸馏数据集构造&lt;/b&gt;&lt;br&gt;读取最近14天DCN Top-500并由本轮Teacher离线打分&lt;br&gt;按request_id和Top/Middle/Bottom分层抽样&lt;br&gt;保留Student在线可取的轻量特征 + 对应时点Item曝光/点击/CTR快照&lt;br&gt;标签：teacher_final_score、teacher_rank/distribution" vertex="1">
          <mxGeometry height="188.88888888888889" width="470" x="465" y="453.3333333333333" as="geometry" />
        </mxCell>
        <mxCell id="offt-student" parent="offt-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;③B 蒸馏训练 DCN：S_N&lt;/b&gt;&lt;br&gt;加载 S_{N-1}；Embedding → Cross + Deep → Fusion → coarse_score&lt;br&gt;L_student = α·MSE(score_T, score_S)&lt;br&gt;　+ β·Pairwise/Listwise(rank_T, rank_S)&lt;br&gt;　+ γ·BCE(Hard Label，可选)&lt;br&gt;固定训练预算，约 1 epoch + Early Stopping" vertex="1">
          <mxGeometry height="188.88888888888889" width="520" x="985" y="453.3333333333333" as="geometry" />
        </mxCell>
        <mxCell id="offt-student-release" parent="offt-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;④B 验证并独立发布 S_N&lt;/b&gt;&lt;br&gt;NDCG / Pairwise Accuracy / 与 T_{N-1} 的排序一致性&lt;br&gt;Top-500 对高质量 Item 的保留率、在线延迟&lt;br&gt;灰度通过后发布 Student S_N；失败继续使用 S_{N-1}" vertex="1">
          <mxGeometry height="188.88888888888889" width="500" x="1555" y="453.3333333333333" as="geometry" />
        </mxCell>
        <mxCell id="offt-release" parent="offt-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;⑤ 本周期在线加载&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;模型组合&lt;/b&gt;&lt;br&gt;DIN/MMoE Teacher T_k&lt;br&gt;+ 由 T_k 蒸馏的 DCN Student S_k&lt;br&gt;&lt;br&gt;分别验证，组合灰度发布；任一失败则保留上一稳定版本&lt;br&gt;&lt;br&gt;周期内模型参数、Embedding字典在线只读；新Item只做前向编码与索引写入" vertex="1">
          <mxGeometry height="538.3333333333333" width="420" x="2440" y="136.94444444444443" as="geometry" />
        </mxCell>
