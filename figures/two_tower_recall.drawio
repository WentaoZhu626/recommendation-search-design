          </mxGeometry>
        </mxCell>
        <mxCell id="BsnuHeq9HasgRQaaghQB-267" parent="BsnuHeq9HasgRQaaghQB-279" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="召回a和b，找到他们的相似物品" vertex="1">
          <mxGeometry height="86.27450980392156" width="100" x="450" y="442.156862745098" as="geometry" />
