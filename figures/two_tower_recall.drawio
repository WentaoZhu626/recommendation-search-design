        <mxCell id="BsnuHeq9HasgRQaaghQB-268" edge="1" parent="BsnuHeq9HasgRQaaghQB-279" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;endArrow=classic;html=1;curved=0;rounded=0;endSize=8;startSize=8;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="570" y="485.2941176470588" as="sourcePoint" />
            <mxPoint x="636" y="485.2941176470588" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BsnuHeq9HasgRQaaghQB-269" parent="BsnuHeq9HasgRQaaghQB-279" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="对相似物品j进行打分，打分公式为" vertex="1">
          <mxGeometry height="32.35294117647059" width="210" x="650" y="409.8039215686274" as="geometry" />
        </mxCell>
        <mxCell id="BsnuHeq9HasgRQaaghQB-272" parent="BsnuHeq9HasgRQaaghQB-279" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="\[&lt;br&gt;\mathrm{contribution}(u,i,j)&lt;br&gt;=&lt;br&gt;w_{u,i}&lt;br&gt;\cdot&lt;br&gt;d(\Delta t_i)&lt;br&gt;\cdot&lt;br&gt;\mathrm{sim}(i,j)&lt;br&gt;\]&lt;br&gt;&amp;nbsp;" vertex="1">
          <mxGeometry height="32.35294117647059" width="370" x="620" y="452.94117647058823" as="geometry" />
        </mxCell>
        <mxCell id="BsnuHeq9HasgRQaaghQB-273" parent="BsnuHeq9HasgRQaaghQB-279" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="其中，\(w_{u,i}\) 表示用户 \(u\) 对历史 Item \(i\) 的行为权重，\(d(\Delta t_i)\) 表示该历史行为的时间衰减系数，这里我们使用半衰期为7天的时间衰减系数，\(\mathrm{sim}(i,j)\) 表示历史 Item \(i\) 与候选 Item \(j\) 的相似度。" vertex="1">
          <mxGeometry height="53.92156862745098" width="400" x="650" y="485.2941176470588" as="geometry" />
        </mxCell>
        <mxCell id="BsnuHeq9HasgRQaaghQB-274" parent="BsnuHeq9HasgRQaaghQB-279" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-family: ui-sans-serif, system-ui, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; text-align: left; white-space: pre;&quot;&gt;$$&lt;br/&gt;d(\Delta t_i) = 2^{-\frac{\Delta t_i}{7}}&lt;br/&gt;$$&lt;/span&gt;" vertex="1">
          <mxGeometry height="21.56862745098039" width="200" x="920" y="442.156862745098" as="geometry" />
        </mxCell>
        <mxCell id="BsnuHeq9HasgRQaaghQB-278" parent="BsnuHeq9HasgRQaaghQB-279" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="\(&lt;br/&gt;\mathrm{sim}(i,j)&lt;br/&gt;=&lt;br/&gt;\frac{&lt;br/&gt;\sum_{u \in U_{ij}} w_{u,i}w_{u,j}&lt;br/&gt;}{&lt;br/&gt;\sqrt{\sum_{u \in U_i} w_{u,i}^{2}}&lt;br/&gt;\sqrt{\sum_{u \in U_j} w_{u,j}^{2}}&lt;br/&gt;}&lt;br/&gt;\)" vertex="1">
          <mxGeometry height="107.84313725490196" width="240" x="1020" as="geometry" />
        </mxCell>
        <mxCell id="BsnuHeq9HasgRQaaghQB-280" edge="1" parent="BsnuHeq9HasgRQaaghQB-279" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;endArrow=classic;html=1;curved=0;rounded=0;endSize=8;startSize=8;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="1107" y="483.28999999999996" as="sourcePoint" />
            <mxPoint x="1173" y="483.28999999999996" as="targetPoint" />
          </mxGeometry>
        </mxCell>
