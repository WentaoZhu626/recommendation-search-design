        <mxCell id="cs-train-title" parent="oIK1UBARI0uj0fFpgnm4-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#1E3A8A;" value="DropoutNet 离线训练与更新" vertex="1">
          <mxGeometry height="96.66666666666666" width="1307.7108433734938" x="32.28915662650593" as="geometry" />
        </mxCell>
        <mxCell id="cs-train-bg" parent="oIK1UBARI0uj0fFpgnm4-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;fillOpacity=25;strokeColor=#60A5FA;strokeWidth=2;dashed=1;" value="" vertex="1">
          <mxGeometry height="552.3809523809523" width="1340" y="27.619047619047706" as="geometry" />
        </mxCell>
        <mxCell id="cs-train-data" parent="oIK1UBARI0uj0fFpgnm4-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#334155;fontSize=11;" value="&lt;b&gt;① 训练样本 / 内容编码&lt;/b&gt;&lt;br&gt;成熟 Item 用户交互对 + Batch内负样本&lt;br&gt;冻结 Text Encoder：title/body → text_embedding&lt;br&gt;冻结 Image Encoder：images → image_embedding&lt;br&gt;无图：零向量 + image_missing=1" vertex="1">
          <mxGeometry height="400.4761904761905" width="355.18072289156623" x="32.28915662650593" y="165.71428571428578" as="geometry" />
        </mxCell>
        <mxCell id="cs-train-fit" parent="oIK1UBARI0uj0fFpgnm4-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=11;" value="&lt;b&gt;② DropoutNet 训练&lt;/b&gt;&lt;br&gt;随机 Drop Item ID/行为表示，模拟新 Item&lt;br&gt;对有图样本可做 Image Modality Dropout&lt;br&gt;保留作者/类目/地点/类型 + 内容向量&lt;br&gt;Projection → SENet → DNN；召回损失 + 表示对齐" vertex="1">
          <mxGeometry height="400.4761904761905" width="443.9759036144578" x="435.9036144578313" y="165.71428571428578" as="geometry" />
        </mxCell>
        <mxCell id="cs-train-update" parent="oIK1UBARI0uj0fFpgnm4-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontSize=11;" value="&lt;b&gt;③ 更新与发布&lt;/b&gt;&lt;br&gt;新/变更内容按 content_hash 重算内容向量&lt;br&gt;用 Item Tower 生成最终 Item Embedding&lt;br&gt;刷新冷 ANN，记录 text/image_encoder_version&lt;br&gt;+ tower/feature/index_version" vertex="1">
          <mxGeometry height="400.4761904761905" width="387.4698795180723" x="920.2409638554218" y="165.71428571428578" as="geometry" />
        </mxCell>
