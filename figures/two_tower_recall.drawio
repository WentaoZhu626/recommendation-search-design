        <mxCell id="data-e-items-pool" edge="1" parent="1" source="Bdmo_KxLg3wMAdoVoUXQ-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#14B8A6;dashed=1;fontColor=#0F766E;" target="BsnuHeq9HasgRQaaghQB-18" value="state=cold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="data-e-pool-recall" edge="1" parent="1" source="kTt3A61G966eXll6c2QL-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#6366F1;dashed=1;fontColor=#4338CA;" target="BsnuHeq9HasgRQaaghQB-1" value="热召回可检索item集合">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rk-title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F2937;" value="在线推荐：按 user_stage 路由 → 模型链路 / 直出策略并行 → 统一编排 Top-30" vertex="1">
          <mxGeometry height="40" width="1300" x="1600" y="58" as="geometry" />
        </mxCell>
        <mxCell id="rk-counts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;fontSize=13;fontStyle=1;" value="U2：既有热 Top-2000 + 冷 Top-100｜U1：DropoutNet normal_ann + cold_ann｜→ 去重/近7天曝光过滤 → Item聚合特征 → DCN Top-500 → MMoE Top-100 → DPP / Thompson Sampling → 阶段编排 Top-30；U0绕过模型" vertex="1">
          <mxGeometry height="42" width="1450" x="1490" y="103" as="geometry" />
        </mxCell>
        <mxCell id="rk-dcn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;spacingRight=8;" value="&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;② 共用粗排：DCN&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;输入&lt;/b&gt;&lt;br&gt;7天曝光硬过滤后的热/冷候选 + cold_stage&lt;br&gt;按 item_id 从 Feature Store 批量读取：exposure_1d/7d/30d、click_1d/7d/30d、ctr_1d/7d/30d、aggregate_missing&lt;br&gt;&lt;br&gt;&lt;b&gt;阶段感知动态提权&lt;/b&gt;&lt;br&gt;S0/S1/S2目标12/30/100次曝光；按时间与曝光进度计算boost&lt;br&gt;coarse_score' = coarse_score × boost&lt;br&gt;&lt;br&gt;&lt;b&gt;输出：Top-500&lt;/b&gt;&lt;br&gt;满足门槛时尽量保留≥30条冷内容；Item聚合特征向后透传" vertex="1">
          <mxGeometry height="405" width="280" x="1315" y="160" as="geometry" />
        </mxCell>
        <mxCell id="rk-din" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#14532D;fontSize=11;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;③a DIN 兴趣建模&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;输入：Top-500 候选 + 用户历史点击序列&lt;/b&gt;&lt;br&gt;候选 Item Embedding 作为 Query，对历史点击 Item Embedding 做候选感知 Attention&lt;br&gt;&lt;b&gt;输出：candidate-aware user_interest_vector&lt;/b&gt;" vertex="1">
          <mxGeometry height="130" width="360" x="1690" y="155" as="geometry" />
        </mxCell>
        <mxCell id="kTt3A61G966eXll6c2QL-10" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;fontColor=#334155;" value="实际曝光 / 交互事件写回 MongoDB">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2785" y="840" />
              <mxPoint x="10" y="840" />
              <mxPoint x="10" y="495" />
            </Array>
            <mxPoint x="2785" y="508.75" as="sourcePoint" />
            <mxPoint x="60" y="495" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rk-mmoe" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#14532D;fontSize=11;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;③b 共用 MMoE 多任务精排&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;输入&lt;/b&gt;&lt;br&gt;DIN兴趣向量 + 用户/Item/上下文特征 + coarse_score + cold_flag&lt;br&gt;+ DCN透传的Item曝光量、点击量、CTR（1d/7d/30d）及缺失标志&lt;br&gt;&lt;br&gt;&lt;b&gt;模型&lt;/b&gt;&lt;br&gt;Shared Experts → Task Gates → Task Towers&lt;br&gt;pCTR · pLike · pFavorite · pComment · pDwell&lt;br&gt;final_score = Σ wₖ × task_scoreₖ&lt;br&gt;&lt;br&gt;&lt;b&gt;输出：Top-100&lt;/b&gt;&lt;br&gt;满足门槛时尽量保留≥12条冷内容；输出final_score与item_embedding" vertex="1">
          <mxGeometry height="225" width="360" x="1690" y="315" as="geometry" />
        </mxCell>
        <mxCell id="rk-e-din-mmoe" edge="1" parent="1" source="rk-din" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#10B981;strokeWidth=2;fontColor=#047857;" target="rk-mmoe" value="兴趣向量 + Item聚合特征透传">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="data-e-item-feature-dcn" edge="1" parent="1" source="data-store-item-feature" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#0284C7;strokeWidth=2;dashed=1;fontColor=#075985;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.669;entryDx=0;entryDy=0;entryPerimeter=0;" target="rk-dcn" value="候选item_ids BatchGet（每日快照）">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="880" y="727.5" />
              <mxPoint x="880" y="590" />
              <mxPoint x="1260" y="590" />
              <mxPoint x="1260" y="430.9" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rk-e-mmoe-rerank" edge="1" parent="1" source="rk-mmoe" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#64748B;strokeWidth=2;fontColor=#334155;" target="rk-rerank" value="Top-100&amp;nbsp;">
          <mxGeometry relative="1" x="-0.0012" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rk-rerank" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;fontSize=11;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;④ 重排：DPP + Bandit 强插&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;输入：混合 Top-100&lt;/b&gt;&lt;br&gt;按 cold_stage 分成热 / 冷候选&lt;br&gt;&lt;br&gt;&lt;b&gt;热内容&lt;/b&gt;&lt;br&gt;Kernel-DPP 根据 final_score 与 item_embedding 平衡质量和多样性&lt;br&gt;&lt;br&gt;&lt;b&gt;冷内容：Thompson Sampling&lt;/b&gt;&lt;br&gt;同阶段/类目共享Beta先验、Item维护独立后验；结合MMoE final_score、抽样探索值和曝光缺口选最多6条；至少2个槽位优先S0，其余由S0/S1/S2竞争&lt;br&gt;&lt;br&gt;&lt;b&gt;输出：Top-30&lt;/b&gt;&lt;br&gt;冷内容插入第5/10/15/20/25/30位；不足6条由热内容回补" vertex="1">
          <mxGeometry height="390" width="320" x="2120" y="170" as="geometry" />
        </mxCell>
        <mxCell id="rk-display" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;⑤ 用户阶段编排、推荐结果与反馈&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;按 user_stage 组装 Top-30&lt;/b&gt;&lt;br&gt;• U0：兴趣热门15 + 全站热门9 + 其他类目随机6，直接输出&lt;br&gt;• U1：模型18→27条 + 直出12→3条；模型冷Item最多3条&lt;br&gt;• U2：既有重排 Top-30 原样进入&lt;br&gt;统一做Item去重和已看/已曝光过滤；不足由同阶段可用池回补&lt;br&gt;&lt;br&gt;&lt;b&gt;曝光回写（仅真正进入可视区）&lt;/b&gt;&lt;br&gt;产生 exposure_event；MongoDB保存完整日志，Redis写入 item_id + exposure_time&lt;br&gt;&lt;br&gt;&lt;b&gt;反馈与阶段更新&lt;/b&gt;&lt;br&gt;点击/停留/正负反馈更新Beta后验与冷Item爬坡状态；不同正反馈Item数N_pos实时更新用户U0/U1/U2阶段" vertex="1">
          <mxGeometry height="390" width="360" x="2605" y="153.75" as="geometry" />
        </mxCell>
