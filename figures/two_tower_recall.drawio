        </mxCell>
        <mxCell id="Bdmo_KxLg3wMAdoVoUXQ-17" parent="Bdmo_KxLg3wMAdoVoUXQ-15" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontStyle=1;" value="在线计算（请求时 / 事件到达时）" vertex="1">
          <mxGeometry height="285" width="180" x="10" y="35" as="geometry" />
        </mxCell>
        <mxCell id="data-online-text" parent="Bdmo_KxLg3wMAdoVoUXQ-17" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacingLeft=7;spacingTop=6;" value="&lt;b&gt;输入&lt;/b&gt;&lt;br&gt;当前请求 + 新行为/曝光 + 新 Item&lt;br&gt;&lt;br&gt;&lt;b&gt;计算 / 维护&lt;/b&gt;&lt;br&gt;• session 最近10次行为序列与实时兴趣&lt;br&gt;• 请求上下文拼接&lt;br&gt;• 新 Item：冻结的 Text/Image Encoder 生成内容向量；无图则零向量 + image_missing=1&lt;br&gt;• Item Tower 生成最终 Item Embedding，增量写入冷 ANN&lt;br&gt;• 曝光到达后维护用户曝光桶&lt;br&gt;&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;&lt;br&gt;在线特征 + 内容/Item向量 + 近30天曝光集合" vertex="1">
          <mxGeometry height="245" width="165" x="8" y="30" as="geometry" />
        </mxCell>
        <mxCell id="Bdmo_KxLg3wMAdoVoUXQ-18" parent="Bdmo_KxLg3wMAdoVoUXQ-15" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F59E0B;fontStyle=1;" value="离线计算（每日统计 + 双周模型训练）" vertex="1">
          <mxGeometry height="285" width="180" x="200" y="35" as="geometry" />
        </mxCell>
        <mxCell id="data-offline-text" parent="Bdmo_KxLg3wMAdoVoUXQ-18" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacingLeft=7;spacingTop=6;" value="&lt;b&gt;每日任务&lt;/b&gt;&lt;br&gt;去重/迟到修正、曝光-反馈关联；重算 UserCF / ItemCF；按Item聚合真实曝光与点击，生成1d/7d/30d曝光量、点击量和CTR快照&lt;br&gt;&lt;br&gt;&lt;b&gt;双周任务&lt;/b&gt;&lt;br&gt;最近14天 + 历史衰减回放；温启动训练双塔/DropoutNet、DIN+MMoE、DCN；Text/Image Encoder冻结&lt;br&gt;&lt;br&gt;&lt;b&gt;发布&lt;/b&gt;&lt;br&gt;验证后发布模型并重算受影响的Item Embedding / ANN" vertex="1">
          <mxGeometry height="245" width="165" x="8" y="30" as="geometry" />
        </mxCell>
        <mxCell id="data-serving" parent="Bdmo_KxLg3wMAdoVoUXQ-15" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontStyle=1;" value="计算结果存储 / 在线服务层" vertex="1">
          <mxGeometry height="290" width="370" x="10" y="330" as="geometry" />
        </mxCell>
        <mxCell id="data-store-online" parent="data-serving" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=7;" value="&lt;b&gt;在线状态（Redis）&lt;/b&gt;&lt;br&gt;session最近行为序列、请求临时状态&lt;br&gt;user_exposure:{uid} ZSET：item_id → last_exposure_ts（7d滑动过期）" vertex="1">
          <mxGeometry height="70" width="170" x="10" y="35" as="geometry" />
        </mxCell>
        <mxCell id="data-store-offline" parent="data-serving" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F59E0B;fontSize=10;align=left;spacingLeft=7;" value="&lt;b&gt;离线结果 / 历史快照&lt;/b&gt;&lt;br&gt;用户序列、CF表、Item聚合特征日快照&lt;br&gt;训练样本与标签（支持Point-in-Time Join）" vertex="1">
          <mxGeometry height="70" width="170" x="190" y="35" as="geometry" />
        </mxCell>
        <mxCell id="data-store-ann" parent="data-serving" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=10;align=left;spacingLeft=7;" value="&lt;b&gt;内容向量 / ANN索引&lt;/b&gt;&lt;br&gt;text/image_embedding + missing mask&lt;br&gt;item_id → 最终 Item Embedding，含index_version" vertex="1">
          <mxGeometry height="70" width="170" x="10" y="120" as="geometry" />
        </mxCell>
        <mxCell id="data-store-model" parent="data-serving" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;fontSize=10;align=left;spacingLeft=7;" value="&lt;b&gt;模型 / 特征版本库&lt;/b&gt;&lt;br&gt;Text/Image Encoder、双塔、DropoutNet、排序模型&lt;br&gt;encoder/tower/feature_version" vertex="1">
          <mxGeometry height="70" width="170" x="190" y="120" as="geometry" />
        </mxCell>
        <mxCell id="data-store-item-feature" parent="data-serving" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontColor=#0C4A6E;fontSize=10;align=left;verticalAlign=top;spacingTop=7;spacingLeft=9;spacingRight=7;" value="&lt;b&gt;在线 Item Feature Store（每日更新）&lt;/b&gt;&lt;br&gt;item_id → exposure_1d/7d/30d · click_1d/7d/30d · ctr_1d/7d/30d&lt;br&gt;ctr_w = click_w / max(exposure_w, 1)；同时保存 feature_time / feature_version / aggregate_missing&lt;br&gt;召回合并后按 item_id BatchGet；不在请求时扫描日志计算" vertex="1">
