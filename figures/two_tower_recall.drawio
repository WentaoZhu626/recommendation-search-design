          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cs-e-train-fit-update" edge="1" parent="oIK1UBARI0uj0fFpgnm4-1" source="cs-train-fit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#22C55E;fontColor=#15803D;" target="cs-train-update" value="模型与 Item 表示">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nu-bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;fillOpacity=35;strokeColor=#8B5CF6;strokeWidth=2;dashed=1;" value="" vertex="1">
          <mxGeometry height="570" width="2180" x="780" y="-650" as="geometry" />
        </mxCell>
        <mxCell id="nu-title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#5B21B6;" value="低活 / 新用户阶段路由（U0、U1每次均返回 Top-30）" vertex="1">
          <mxGeometry height="40" width="2050" x="840" y="-635" as="geometry" />
        </mxCell>
        <mxCell id="nu-subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#64748B;" value="N_pos = count(distinct positive item_id)；同一Item重复正反馈只计1个；阶段随反馈实时更新，不等待每日离线任务" vertex="1">
          <mxGeometry height="28" width="1900" x="915" y="-595" as="geometry" />
        </mxCell>
        <mxCell id="nu-router" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#334155;fontSize=12;fontStyle=1;" value="推荐请求时&lt;br&gt;读取 user_stage" vertex="1">
          <mxGeometry height="150" width="170" x="830" y="-440" as="geometry" />
        </mxCell>
        <mxCell id="oIK1UBARI0uj0fFpgnm4-9" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#9A3412;fontSize=11;fontStyle=1;" value="U0 冷启动&lt;br&gt;尚未同时满足&lt;br&gt;N_pos ≥ 10 且会话 ≥ 2&lt;br&gt;不使用模型" vertex="1">
          <mxGeometry height="130" width="180" x="1080" y="-580" as="geometry" />
        </mxCell>
        <mxCell id="oIK1UBARI0uj0fFpgnm4-10" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;fontStyle=1;" value="U1 个性化过渡&lt;br&gt;已满足 N_pos ≥ 10 且会话 ≥ 2&lt;br&gt;尚未同时满足&lt;br&gt;N_pos ≥ 30 且会话 ≥ 5" vertex="1">
          <mxGeometry height="130" width="180" x="1080" y="-400" as="geometry" />
        </mxCell>
        <mxCell id="oIK1UBARI0uj0fFpgnm4-11" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#14532D;fontSize=12;fontStyle=1;" value="U2 正常用户&lt;br&gt;N_pos ≥ 30&lt;br&gt;且≥5个活跃会话" vertex="1">
          <mxGeometry height="130" width="180" x="1080" y="-220" as="geometry" />
        </mxCell>
        <mxCell id="nu-u0-path" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=2;fontColor=#9A3412;fontSize=12;align=left;spacingLeft=14;" value="&lt;b&gt;U0：三个直出策略池&lt;/b&gt;&lt;br&gt;兴趣热门随机15条 + 全站热门随机9条&lt;br&gt;+ 其他类目随机6条 = Top-30&lt;br&gt;绕过召回、DCN、DIN、MMoE与重排" vertex="1">
          <mxGeometry height="130" width="560" x="1330" y="-580" as="geometry" />
        </mxCell>
        <mxCell id="nu-u1-path" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=12;align=left;spacingLeft=14;" value="&lt;b&gt;U1：模型路 + 直出路并行&lt;/b&gt;&lt;br&gt;模型路：正反馈序列/兴趣/上下文 → DropoutNet User Tower → normal_ann + cold_ann → 共用DCN、DIN+MMoE、DPP/TS&lt;br&gt;直出路：兴趣热门 + 全站热门 + 其他类目随机探索，绕过排序" vertex="1">
          <mxGeometry height="150" width="650" x="1330" y="-410" as="geometry" />
        </mxCell>
