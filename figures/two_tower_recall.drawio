        <mxCell id="kdpp-bg" parent="kdpp-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F97316;strokeWidth=2;dashed=1;" value="" vertex="1">
          <mxGeometry height="885" width="2880" x="10" y="5" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-title" parent="kdpp-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#9A3412;" value="Kernel-DPP 重排技术流程（独立技术细节）" vertex="1">
          <mxGeometry height="42" width="1500" x="700" y="22" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-subtitle" parent="kdpp-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#64748B;" value="MMoE 热候选：final_score + item_embedding → 质量向量 q + 相似度矩阵 S → L-ensemble Kernel → Fast Greedy MAP → 多样化热内容列表" vertex="1">
          <mxGeometry height="30" width="2050" x="430" y="66" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-input" parent="kdpp-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;① 输入准备&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;来自 MMoE Top-100，先分离热 / 冷候选&lt;/b&gt;&lt;br&gt;Kernel-DPP 只处理热候选集合 H，M ≤ 100&lt;br&gt;&lt;br&gt;每条热候选包含：&lt;br&gt;• item_id&lt;br&gt;• final_scoreᵢ（相关性 / 质量）&lt;br&gt;• item_embeddingᵢ ∈ ℝᵈ&lt;br&gt;• category / author（硬约束可选）&lt;br&gt;&lt;br&gt;&lt;b&gt;目标数量&lt;/b&gt;&lt;br&gt;K_hot = 30 − n_cold，n_cold ≤ 6" vertex="1">
          <mxGeometry height="350" width="300" x="40" y="135" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-quality" parent="kdpp-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=12;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;②a 质量项 q&lt;/b&gt;&lt;/div&gt;&lt;br&gt;对 final_score 做 Clip / Normalize，避免数值跨度过大&lt;br&gt;&lt;br&gt;qᵢ = exp(α · normalized_scoreᵢ)&lt;br&gt;&lt;br&gt;要求 qᵢ &amp;gt; 0；α 控制精排相关性在 DPP 中的权重&lt;br&gt;&lt;br&gt;&lt;b&gt;输出：q ∈ ℝᴹ&lt;/b&gt;" vertex="1">
          <mxGeometry height="160" width="360" x="400" y="125" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-similarity" parent="kdpp-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;②b 距离 → 相似度矩阵 S&lt;/b&gt;&lt;/div&gt;&lt;br&gt;先归一化 Item Embedding：zᵢ = eᵢ / ‖eᵢ‖₂&lt;br&gt;&lt;br&gt;两两距离：d²ᵢⱼ = ‖zᵢ − zⱼ‖²₂&lt;br&gt;RBF 相似度：Sᵢⱼ = exp(−d²ᵢⱼ / 2σ²)&lt;br&gt;Sᵢᵢ = 1&lt;br&gt;&lt;br&gt;Embedding 越接近 → Sᵢⱼ 越大 → 越不希望同时选入&lt;br&gt;&lt;b&gt;输出：S ∈ ℝᴹˣᴹ（PSD）&lt;/b&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="400" y="305" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-kernel" parent="kdpp-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;③ 构造 L-ensemble Kernel&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;br&gt;L = Diag(q) · S · Diag(q)&lt;br&gt;&lt;br&gt;Lᵢⱼ = qᵢ · Sᵢⱼ · qⱼ&lt;br&gt;&lt;br&gt;数值稳定：L ← L + εI&lt;br&gt;&lt;br&gt;对任意候选子集 Y：&lt;br&gt;det(Lᵧ) 同时反映&lt;br&gt;• 所选 Item 的质量&lt;br&gt;• 所选 Item 的非重复程度&lt;br&gt;&lt;br&gt;&lt;b&gt;输出：L ∈ ℝᴹˣᴹ&lt;/b&gt;" vertex="1">
          <mxGeometry height="320" width="400" x="820" y="155" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-greedy" parent="kdpp-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;④ Fast Greedy MAP 选择&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;初始化&lt;/b&gt;：Y = ∅&lt;br&gt;&lt;br&gt;循环直到 |Y| = K_hot：&lt;br&gt;1. 对每个未选择候选 i 计算加入后的边际 log-det 增益&lt;br&gt;2. 选择增益最大的 i*&lt;br&gt;3. Y ← Y ∪ {i*}&lt;br&gt;4. 增量更新 Cholesky 状态&lt;br&gt;&lt;br&gt;选择顺序直接作为 DPP 热内容顺序；增量 Cholesky 避免每轮从头计算 determinant&lt;br&gt;&lt;br&gt;&lt;b&gt;输出：有序集合 Y，长度 K_hot&lt;/b&gt;" vertex="1">
          <mxGeometry height="360" width="500" x="1280" y="135" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-guard" parent="kdpp-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;⑤ 约束与兜底&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;进入 DPP 前&lt;/b&gt;&lt;br&gt;在线状态 / 7天曝光已过滤&lt;br&gt;&lt;br&gt;&lt;b&gt;Greedy 过程中（可选）&lt;/b&gt;&lt;br&gt;• 单作者数量上限&lt;br&gt;• 单类目数量上限&lt;br&gt;• 重复内容硬过滤&lt;br&gt;&lt;br&gt;&lt;b&gt;兜底&lt;/b&gt;&lt;br&gt;若候选不足、矩阵异常或边际增益过小，剩余位置按 final_score 降序补齐" vertex="1">
          <mxGeometry height="360" width="380" x="1840" y="135" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-output" parent="kdpp-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;⑥ 输出与主流程接口&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Kernel-DPP 输出&lt;/b&gt;&lt;br&gt;dpp_hot_list：&lt;br&gt;• item_id&lt;br&gt;• dpp_rank&lt;br&gt;• final_score&lt;br&gt;• marginal_gain（日志可选）&lt;br&gt;• dpp_version&lt;br&gt;&lt;br&gt;&lt;b&gt;与冷启动模块合并&lt;/b&gt;&lt;br&gt;接收 Thompson Sampling 选出的 n_cold ≤ 6 条冷内容，按每5个位置约1条的规则强插&lt;br&gt;&lt;br&gt;&lt;b&gt;最终输出：Top-30 有序列表&lt;/b&gt;" vertex="1">
          <mxGeometry height="360" width="480" x="2280" y="135" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-params" parent="kdpp-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;参数与解释&lt;/b&gt;&lt;br&gt;• α：相关性强度；越大越偏向高 final_score&lt;br&gt;• σ：相似度作用范围；越大，更多物品会被视为相似，多样性排斥范围更广&lt;br&gt;• ε：数值稳定项，例如 1e−6&lt;br&gt;• M：进入 DPP 的热候选数，当前 ≤100&lt;br&gt;• K_hot：需要输出的热内容数量，通常为 24～30&lt;br&gt;&lt;br&gt;α / σ 通过离线 NDCG、ILD、类目覆盖率以及在线 CTR / 停留实验调参。" vertex="1">
          <mxGeometry height="215" width="620" x="40" y="570" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-meaning" parent="kdpp-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontColor=#312E81;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;为什么 determinant 能同时表达质量与多样性？&lt;/b&gt;&lt;br&gt;&lt;br&gt;对角线 Lᵢᵢ = qᵢ²：高精排分数提高被选概率。&lt;br&gt;&lt;br&gt;非对角线由 Sᵢⱼ 控制：两个 Item 越相似，对应向量越接近平行，det(Lᵧ) 增长越小；差异大的 Item 会张成更大的体积。&lt;br&gt;&lt;br&gt;因此 DPP 不是简单“打散类目”，而是在整个集合层面平衡相关性和非重复性。" vertex="1">
          <mxGeometry height="215" width="650" x="700" y="570" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-online-note" parent="kdpp-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;在线执行与性能控制&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Item Embedding 已由 MMoE / Item Tower 提供，不在重排阶段重新编码。&lt;br&gt;2. M≤100，只构造热候选的 M×M 矩阵。&lt;br&gt;3. 使用增量 Cholesky 的 Fast Greedy MAP，不从头枚举所有子集。&lt;br&gt;4. 设置最大计算时延；超时直接回退 final_score 排序。&lt;br&gt;5. 日志记录 α、σ、dpp_version、候选数和最终选择结果，便于回放。" vertex="1">
          <mxGeometry height="215" width="700" x="1390" y="570" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-contract" parent="kdpp-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#7C2D12;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;模块接口（供工程实现）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;输入&lt;/b&gt;&lt;br&gt;(request_id, K_hot, [{item_id, final_score, item_embedding, category, author}])&lt;br&gt;&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;&lt;br&gt;[{item_id, dpp_rank, final_score, marginal_gain}]&lt;br&gt;&lt;br&gt;&lt;b&gt;注意&lt;/b&gt;&lt;br&gt;Item Embedding 必须来自同一 embedding_version；维度不一致或缺失的候选先过滤或走 final_score 兜底。" vertex="1">
          <mxGeometry height="215" width="630" x="2130" y="570" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-e-input-quality" edge="1" parent="kdpp-1" source="kdpp-input" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1D4ED8;" target="kdpp-quality" value="final_score">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-e-input-sim" edge="1" parent="kdpp-1" source="kdpp-input" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#10B981;strokeWidth=2;fontColor=#047857;" target="kdpp-similarity" value="item_embedding">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-e-quality-kernel" edge="1" parent="kdpp-1" source="kdpp-quality" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1D4ED8;" target="kdpp-kernel" value="q">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-e-sim-kernel" edge="1" parent="kdpp-1" source="kdpp-similarity" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#10B981;strokeWidth=2;fontColor=#047857;" target="kdpp-kernel" value="S">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-e-kernel-greedy" edge="1" parent="kdpp-1" source="kdpp-kernel" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#5B21B6;" target="kdpp-greedy" value="L Kernel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-e-greedy-guard" edge="1" parent="kdpp-1" source="kdpp-greedy" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#F97316;strokeWidth=2;fontColor=#C2410C;" target="kdpp-guard" value="DPP 顺序">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kdpp-e-guard-output" edge="1" parent="kdpp-1" source="kdpp-guard" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#EC4899;strokeWidth=2;fontColor=#BE185D;" target="kdpp-output" value="K_hot 条热内容">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-1" connectable="0" parent="1" style="group;" value="" vertex="1">
          <mxGeometry height="730" width="1400" x="-170" y="5110" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-bg" parent="tech-dcn-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;dashed=1;" value="" vertex="1">
          <mxGeometry height="720" width="1390" x="5" y="5" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-title" parent="tech-dcn-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1E3A8A;" value="① DCN：离线训练与在线推理" vertex="1">
          <mxGeometry height="40" width="1000" x="200" y="18" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-subtitle" parent="tech-dcn-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#64748B;" value="Student 学习昨日 Teacher 对 Top-500 的打分；在线只做一次前向计算，输出基础 coarse_score" vertex="1">
          <mxGeometry height="28" width="1100" x="150" y="55" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-train-lane" parent="tech-dcn-1" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#EFF6FF;swimlaneFillColor=#FFFFFF;strokeColor=#60A5FA;fontColor=#1E3A8A;fontStyle=1;fontSize=15;" value="A. 离线训练（每14天或样本阈值触发）" vertex="1">
          <mxGeometry height="600" width="650" x="25" y="95" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-train-data" parent="tech-dcn-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;1. 蒸馏样本&lt;/b&gt;&lt;br&gt;最近14天候选由本轮Teacher离线打分&lt;br&gt;输入：user/item/context/recall/cold_stage + 曝光量、点击量、CTR（1d/7d/30d）&lt;br&gt;Item聚合特征按 request_time 做Point-in-Time Join，并保存feature_time/version&lt;br&gt;标签：teacher_final_score、teacher_rank/distribution；可选Hard Label" vertex="1">
          <mxGeometry height="130" width="590" x="55" y="150" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-train-forward" parent="tech-dcn-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;2. 前向传播与蒸馏损失&lt;/b&gt;&lt;br&gt;Embedding → x₀；Cross：xₗ₊₁ = x₀(xₗᵀwₗ)+bₗ+xₗ&lt;br&gt;Deep：hₗ₊₁ = ReLU(Wₗhₗ+bₗ)&lt;br&gt;Fusion → student_score&lt;br&gt;&lt;br&gt;L = α·MSE(score_T, score_S)&lt;br&gt;　+ β·L_pair/list(rank_T, rank_S)&lt;br&gt;　+ γ·BCE(y_hard, p_S)（可选）" vertex="1">
          <mxGeometry height="185" width="590" x="55" y="305" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-train-release" parent="tech-dcn-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;3. 更新、验证、发布&lt;/b&gt;&lt;br&gt;加载 S_{N-1}，固定预算约1 epoch + Early Stopping&lt;br&gt;验证 NDCG、Pairwise Accuracy、Teacher排序一致性、Top-500保留率和延迟&lt;br&gt;通过后发布只读参数 S_N；失败继续 S_{N-1}" vertex="1">
          <mxGeometry height="145" width="590" x="55" y="520" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-infer-lane" parent="tech-dcn-1" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#ECFDF5;swimlaneFillColor=#FFFFFF;strokeColor=#10B981;fontColor=#14532D;fontStyle=1;fontSize=15;" value="B. 在线推理（每次推荐请求）" vertex="1">
          <mxGeometry height="600" width="650" x="725" y="95" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-infer-input" parent="tech-dcn-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;1. 输入候选 + Item Feature Store批量查询&lt;/b&gt;&lt;br&gt;热 Top-2000 + 冷 Top-100 合并去重并完成近7天曝光硬过滤&lt;br&gt;按候选item_ids BatchGet每日快照：exposure/click/ctr（1d/7d/30d）+ missing/time/version&lt;br&gt;得到约≤2100条完整粗排记录" vertex="1">
          <mxGeometry height="130" width="590" x="755" y="150" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-infer-forward" parent="tech-dcn-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;2. 批量前向计算&lt;/b&gt;&lt;br&gt;按训练时相同的 feature_schema 编码&lt;br&gt;同一 x₀ 并行进入 Cross Network 与 Deep Network&lt;br&gt;Concat + Prediction Head → base_coarse_score&lt;br&gt;参数、Embedding字典、归一化参数在线只读" vertex="1">
          <mxGeometry height="160" width="590" x="755" y="305" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-infer-output" parent="tech-dcn-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#7C2D12;fontSize=12;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;3. 策略后处理与输出&lt;/b&gt;&lt;br&gt;热内容：score = base_coarse_score&lt;br&gt;冷内容：score = base_coarse_score × stage_boost&lt;br&gt;统一排序输出 Top-500（满足门槛时尽量保留≥30冷）&lt;br&gt;超时回退 base_coarse_score 或召回顺序" vertex="1">
          <mxGeometry height="165" width="590" x="755" y="495" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-e-train-12" edge="1" parent="tech-dcn-1" source="tech-dcn-train-data" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#3B82F6;strokeWidth=2;" target="tech-dcn-train-forward" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-e-train-23" edge="1" parent="tech-dcn-1" source="tech-dcn-train-forward" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#22C55E;strokeWidth=2;" target="tech-dcn-train-release" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-e-infer-12" edge="1" parent="tech-dcn-1" source="tech-dcn-infer-input" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#10B981;strokeWidth=2;" target="tech-dcn-infer-forward" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-dcn-e-infer-23" edge="1" parent="tech-dcn-1" source="tech-dcn-infer-forward" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#F97316;strokeWidth=2;" target="tech-dcn-infer-output" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-boost-1" connectable="0" parent="1" style="group;" value="" vertex="1">
          <mxGeometry height="730" width="1450" x="1260" y="5110" as="geometry" />
        </mxCell>
        <mxCell id="tech-boost-bg" parent="tech-boost-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F97316;strokeWidth=2;dashed=1;" value="" vertex="1">
          <mxGeometry height="720" width="1440" x="5" y="5" as="geometry" />
        </mxCell>
        <mxCell id="tech-boost-title" parent="tech-boost-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#9A3412;" value="② 阶段感知动态提权：S0 / S1 / S2" vertex="1">
          <mxGeometry height="40" width="1000" x="225" y="18" as="geometry" />
        </mxCell>
        <mxCell id="tech-boost-subtitle" parent="tech-boost-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#64748B;" value="仅当曝光进度落后于时间进度时提权；达到进度、未过质量门或热内容均不额外提权" vertex="1">
          <mxGeometry height="28" width="1200" x="125" y="55" as="geometry" />
        </mxCell>
        <mxCell id="tech-boost-input" parent="tech-boost-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;1. 每条冷候选输入&lt;/b&gt;&lt;br&gt;s：当前阶段 S0/S1/S2&lt;br&gt;n：累计真实曝光次数&lt;br&gt;t_s：进入当前阶段时间&lt;br&gt;base：DCN基础粗排分&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="300" x="35" y="115" as="geometry" />
        </mxCell>
        <mxCell id="tech-boost-threshold" parent="tech-boost-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#78350F;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;2. 阶段区间与时间预算&lt;/b&gt;&lt;br&gt;下界 L_s = {0, 12, 30}&lt;br&gt;上界 U_s = {12, 30, 100}&lt;br&gt;阶段新增曝光量 = {12, 18, 70}&lt;br&gt;&lt;br&gt;默认 H_s = {6h, 18h, 48h}&lt;br&gt;合计最长保护期72h，可配置" vertex="1">
          <mxGeometry height="205" width="310" x="370" y="115" as="geometry" />
        </mxCell>
        <mxCell id="tech-boost-progress" parent="tech-boost-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#7C2D12;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;3. 两个归一化进度&lt;/b&gt;&lt;br&gt;曝光进度：&lt;br&gt;p_e = clip((n−L_s)/(U_s−L_s), 0, 1)&lt;br&gt;&lt;br&gt;时间进度：&lt;br&gt;p_t = clip((now−t_s)/H_s, 0, 1)&lt;br&gt;&lt;br&gt;进度缺口：g = max(0, p_t−p_e)" vertex="1">
          <mxGeometry height="205" width="330" x="715" y="115" as="geometry" />
        </mxCell>
        <mxCell id="tech-boost-formula" parent="tech-boost-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;4. Boost公式&lt;/b&gt;&lt;br&gt;boost_raw = 1 + λ_s · g^γ&lt;br&gt;boost = clip(boost_raw, 1, B_s)&lt;br&gt;&lt;br&gt;推荐初值：γ=1&lt;br&gt;λ_s = {1.5, 1.0, 0.6}&lt;br&gt;B_s = {2.5, 2.0, 1.6}&lt;br&gt;&lt;br&gt;越早期保护越强；参数需离线回放 + A/B校准" vertex="1">
          <mxGeometry height="205" width="330" x="1080" y="115" as="geometry" />
        </mxCell>
        <mxCell id="tech-boost-example" parent="tech-boost-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontColor=#312E81;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;计算示例：S0&lt;/b&gt;&lt;br&gt;进入S0已3小时：p_t=3/6=0.50&lt;br&gt;当前真实曝光3次：p_e=3/12=0.25&lt;br&gt;g=0.25，λ₀=1.5，γ=1&lt;br&gt;boost=1+1.5×0.25=1.375&lt;br&gt;&lt;br&gt;如果已曝光6次，则p_e=0.50，g=0，boost=1，不再额外提权。" vertex="1">
          <mxGeometry height="255" width="620" x="70" y="385" as="geometry" />
        </mxCell>
        <mxCell id="tech-boost-output" parent="tech-boost-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;输出与保护规则&lt;/b&gt;&lt;br&gt;冷内容：score′ = base × boost&lt;br&gt;热内容：score′ = base&lt;br&gt;&lt;br&gt;达到 U_s 后立即进入阶段评估：决定晋级、转Warm或完成冷启动；&lt;b&gt;阶段转移不由 Thompson Sampling 决定&lt;/b&gt;。" vertex="1">
          <mxGeometry height="255" width="650" x="735" y="385" as="geometry" />
        </mxCell>
        <mxCell id="tech-boost-e-12" edge="1" parent="tech-boost-1" source="tech-boost-input" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#F97316;strokeWidth=2;" target="tech-boost-threshold" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-boost-e-23" edge="1" parent="tech-boost-1" source="tech-boost-threshold" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#F97316;strokeWidth=2;" target="tech-boost-progress" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-boost-e-34" edge="1" parent="tech-boost-1" source="tech-boost-progress" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#EA580C;strokeWidth=2;" target="tech-boost-formula" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-din-1" connectable="0" parent="1" style="group;" value="" vertex="1">
          <mxGeometry height="760" width="1400" x="-160" y="5910" as="geometry" />
        </mxCell>
        <mxCell id="tech-din-bg" parent="tech-din-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;dashed=1;" value="" vertex="1">
          <mxGeometry height="750" width="1390" x="5" y="5" as="geometry" />
        </mxCell>
        <mxCell id="tech-din-title" parent="tech-din-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#047857;" value="③ DIN：候选感知兴趣的训练与推理" vertex="1">
          <mxGeometry height="40" width="1000" x="200" y="18" as="geometry" />
        </mxCell>
        <mxCell id="tech-din-subtitle" parent="tech-din-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#64748B;" value="同一用户面对不同候选 Item，会得到不同的 user_interest_vector；DIN与MMoE端到端联合训练" vertex="1">
          <mxGeometry height="28" width="1120" x="140" y="55" as="geometry" />
        </mxCell>
        <mxCell id="tech-din-sample" parent="tech-din-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;1. 训练样本构造&lt;/b&gt;&lt;br&gt;每条曝光样本确定候选 Item q&lt;br&gt;只截取该曝光发生前的点击/正反馈序列 H=(h₁…h_L)&lt;br&gt;按 event_time 排序，截断/补齐至 L（建议先用50），Padding位置生成 mask&lt;br&gt;禁止把候选曝光后的行为放进历史" vertex="1">
          <mxGeometry height="385" width="300" x="35" y="125" as="geometry" />
        </mxCell>
        <mxCell id="tech-din-attention" parent="tech-din-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;2. Local Activation Unit&lt;/b&gt;&lt;br&gt;候选向量 q = Embedding(candidate)&lt;br&gt;历史向量 e_j = Embedding(h_j)&lt;br&gt;&lt;br&gt;z_j = [e_j, q, e_j−q, e_j⊙q]&lt;br&gt;a_j = MLP(z_j)&lt;br&gt;v_interest(q) = Σ_j mask_j·a_j·e_j&lt;br&gt;&lt;br&gt;a_j越大，表示该历史行为对当前候选越相关；权重可不强制Softmax归一化。" vertex="1">
          <mxGeometry height="385" width="315" x="365" y="125" as="geometry" />
        </mxCell>
        <mxCell id="tech-din-train" parent="tech-din-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#22C55E;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;3. 与MMoE联合训练&lt;/b&gt;&lt;br&gt;将 v_interest(q) 与用户/Item/上下文、coarse_score、cold_flag 拼接后送入MMoE&lt;br&gt;&lt;br&gt;DIN通常不单独设置业务标签；来自MMoE各任务的梯度反向传播，联合更新：&lt;br&gt;• 历史/候选Embedding&lt;br&gt;• Local Activation MLP&lt;br&gt;• MMoE Experts / Gates / Towers" vertex="1">
          <mxGeometry height="385" width="315" x="710" y="125" as="geometry" />
        </mxCell>
        <mxCell id="tech-din-infer" parent="tech-din-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;4. 在线推理&lt;/b&gt;&lt;br&gt;输入：DCN Top-500 + 用户最近L条历史序列&lt;br&gt;历史 Item Embedding 一次读取并复用；500个候选 q 批量计算 500×L 个激活权重&lt;br&gt;输出：每个候选各自的 candidate-aware user_interest_vector&lt;br&gt;&lt;br&gt;空序列：全mask，输出零兴趣向量并由其他用户/上下文特征继续推理。" vertex="1">
          <mxGeometry height="385" width="315" x="1055" y="125" as="geometry" />
        </mxCell>
        <mxCell id="tech-din-contract" parent="tech-din-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;接口&lt;/b&gt;　输入：(request_id, history_item_ids[L], candidate_item_ids[≤500], sequence_mask)　→　输出：interest_vectors[≤500, d]。训练与推理必须使用同一序列截断规则、Embedding版本和mask语义。" vertex="1">
          <mxGeometry height="125" width="1300" x="50" y="565" as="geometry" />
        </mxCell>
        <mxCell id="tech-din-e-12" edge="1" parent="tech-din-1" source="tech-din-sample" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#10B981;strokeWidth=2;" target="tech-din-attention" value="历史 + 候选">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-din-e-23" edge="1" parent="tech-din-1" source="tech-din-attention" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#10B981;strokeWidth=2;" target="tech-din-train" value="兴趣向量">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-din-e-34" edge="1" parent="tech-din-1" source="tech-din-train" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#16A34A;strokeWidth=2;" target="tech-din-infer" value="发布参数">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-mmoe-1" connectable="0" parent="1" style="group;" value="" vertex="1">
          <mxGeometry height="760" width="1450" x="1300" y="5910" as="geometry" />
        </mxCell>
        <mxCell id="tech-mmoe-bg" parent="tech-mmoe-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;dashed=1;" value="" vertex="1">
          <mxGeometry height="750" width="1440" x="5" y="5" as="geometry" />
        </mxCell>
        <mxCell id="tech-mmoe-title" parent="tech-mmoe-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#5B21B6;" value="④ MMoE：多任务精排的训练与推理" vertex="1">
          <mxGeometry height="40" width="1000" x="225" y="18" as="geometry" />
        </mxCell>
        <mxCell id="tech-mmoe-subtitle" parent="tech-mmoe-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#64748B;" value="共享Experts学习共性，每个任务用独立Gate选择专家组合，再进入独立Task Tower" vertex="1">
          <mxGeometry height="28" width="1160" x="145" y="55" as="geometry" />
        </mxCell>
        <mxCell id="tech-mmoe-input" parent="tech-mmoe-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;1. 精排输入 x&lt;/b&gt;&lt;br&gt;DIN候选感知兴趣向量&lt;br&gt;+ user / item / context&lt;br&gt;+ coarse_score / recall_channel&lt;br&gt;+ cold_flag / cold_stage&lt;br&gt;+ DCN透传的exposure/click/ctr（1d/7d/30d）与aggregate_missing&lt;br&gt;&lt;br&gt;训练标签仍来自真实曝光后的反馈。" vertex="1">
          <mxGeometry height="385" width="300" x="35" y="125" as="geometry" />
        </mxCell>
        <mxCell id="tech-mmoe-core" parent="tech-mmoe-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;2. Experts + Task Gates&lt;/b&gt;&lt;br&gt;第k个共享专家：E_k(x)=MLP_k(x)&lt;br&gt;任务t的Gate：g_t(x)=softmax(W_t x+b_t)&lt;br&gt;任务表示：h_t=Σ_k g_{t,k}(x)E_k(x)&lt;br&gt;任务塔：ŷ_t=Tower_t(h_t)&lt;br&gt;&lt;br&gt;每个任务拥有独立Gate，因此点击与停留可以选择不同的专家权重。" vertex="1">
          <mxGeometry height="385" width="325" x="365" y="125" as="geometry" />
        </mxCell>
        <mxCell id="tech-mmoe-train" parent="tech-mmoe-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A78BFA;fontColor=#4C1D95;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;3. 多任务联合训练&lt;/b&gt;&lt;br&gt;分类：L_t = BCE(y_t, p_t)&lt;br&gt;停留：Huber / MSE（可对log dwell建模）&lt;br&gt;总损失：L = Σ_t λ_t·m_t·L_t&lt;br&gt;m_t为标签可用mask；λ_t先固定，再按梯度规模/业务目标调参&lt;br&gt;&lt;br&gt;加载 T_{N-1}，约1 epoch + Early Stopping；分别验证各任务AUC/LogLoss/回归误差。" vertex="1">
          <mxGeometry height="385" width="330" x="720" y="125" as="geometry" />
        </mxCell>
        <mxCell id="tech-mmoe-infer" parent="tech-mmoe-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;fontColor=#831843;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;4. 在线推理与输出&lt;/b&gt;&lt;br&gt;DCN Top-500 批量前向：输出 pCTR、pLike、pFavorite、pComment、pDwell&lt;br&gt;先按任务校准，再组合：&lt;br&gt;final_score = Σ_t w_t·Calibrate(ŷ_t)&lt;br&gt;&lt;br&gt;按 final_score 输出Top-100，同时透传/输出 item_embedding，供Kernel-DPP计算pairwise距离。" vertex="1">
          <mxGeometry height="385" width="330" x="1080" y="125" as="geometry" />
        </mxCell>
        <mxCell id="tech-mmoe-note" parent="tech-mmoe-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F59E0B;fontColor=#78350F;fontSize=12;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;重要区分&lt;/b&gt;　λ_t控制训练时各任务损失对参数更新的影响；w_t控制在线最终排序分的业务取舍，两者不是同一组权重。模型版本需同时记录task_schema、λ、校准器与w。" vertex="1">
          <mxGeometry height="125" width="1340" x="55" y="565" as="geometry" />
        </mxCell>
        <mxCell id="tech-mmoe-e-12" edge="1" parent="tech-mmoe-1" source="tech-mmoe-input" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#8B5CF6;strokeWidth=2;" target="tech-mmoe-core" value="x">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-mmoe-e-23" edge="1" parent="tech-mmoe-1" source="tech-mmoe-core" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#8B5CF6;strokeWidth=2;" target="tech-mmoe-train" value="各任务预测">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-mmoe-e-34" edge="1" parent="tech-mmoe-1" source="tech-mmoe-train" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#EC4899;strokeWidth=2;" target="tech-mmoe-infer" value="发布 T_N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-ts-1" connectable="0" parent="1" style="group;" value="" vertex="1">
          <mxGeometry height="760" width="2900" x="-160" y="6720" as="geometry" />
        </mxCell>
        <mxCell id="tech-ts-bg" parent="tech-ts-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EC4899;strokeWidth=2;dashed=1;" value="" vertex="1">
          <mxGeometry height="750" width="2880" x="10" y="5" as="geometry" />
        </mxCell>
        <mxCell id="tech-ts-title" parent="tech-ts-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#BE185D;" value="⑤ Thompson Sampling：冷内容六个强插槽位的在线选择过程" vertex="1">
          <mxGeometry height="40" width="1600" x="650" y="18" as="geometry" />
        </mxCell>
        <mxCell id="tech-ts-subtitle" parent="tech-ts-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#64748B;" value="MMoE Top-100中的冷候选 → 后验抽样探索 → 结合相关性和曝光缺口 → 最多选择6条；TS不负责S0/S1/S2阶段转移" vertex="1">
          <mxGeometry height="28" width="2100" x="400" y="55" as="geometry" />
        </mxCell>
        <mxCell id="tech-ts-prior" parent="tech-ts-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;1. 建立Beta先验/后验&lt;/b&gt;&lt;br&gt;按 stage × category 维护共享先验：Beta(α₀,β₀)&lt;br&gt;每个 Item i 有独立后验：Beta(α_i,β_i)&lt;br&gt;&lt;br&gt;新Item从同阶段同类目先验开始，既不等于完全随机，也不会因零样本永远没有机会。&lt;br&gt;&lt;br&gt;输入冷候选已完成去重、在线状态与7天曝光硬过滤。" vertex="1">
          <mxGeometry height="410" width="480" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="tech-ts-sample" parent="tech-ts-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;2. 每次请求随机抽样&lt;/b&gt;&lt;br&gt;对每个冷候选 i：&lt;br&gt;θ_i ~ Beta(α_i, β_i)&lt;br&gt;&lt;br&gt;均值高且不确定性低的优质内容通常得到较高θ；样本少、方差大的内容偶尔也会抽到高θ，从而获得探索曝光。&lt;br&gt;&lt;br&gt;一次请求只抽一次；记录随机种子/策略版本便于回放。" vertex="1">
          <mxGeometry height="410" width="480" x="560" y="130" as="geometry" />
        </mxCell>
        <mxCell id="tech-ts-score" parent="tech-ts-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#7C2D12;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;3. 合成冷内容选择分&lt;/b&gt;&lt;br&gt;阶段曝光缺口：&lt;br&gt;gap_i = clip((U_s−n_i)/(U_s−L_s),0,1)&lt;br&gt;&lt;br&gt;bandit_score_i =&lt;br&gt;w_m·Norm(final_score_i)&lt;br&gt;+ w_θ·θ_i&lt;br&gt;+ w_g·gap_i&lt;br&gt;+ w_s·stage_bonus_s&lt;br&gt;&lt;br&gt;final_score保证相关性，θ提供探索，gap/stage保证保量。" vertex="1">
          <mxGeometry height="410" width="520" x="1080" y="130" as="geometry" />
        </mxCell>
        <mxCell id="tech-ts-select" parent="tech-ts-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;4. 约束选择与强插&lt;/b&gt;&lt;br&gt;按 bandit_score 排序选择 n_cold≤6&lt;br&gt;• 至少2个槽位优先S0（有候选时）&lt;br&gt;• 其余槽位由S0/S1/S2共同竞争&lt;br&gt;• 同作者/类目上限仍生效&lt;br&gt;&lt;br&gt;插入第5/10/15/20/25/30位；冷候选不足6条时用Kernel-DPP热内容回补，不强行凑数。" vertex="1">
          <mxGeometry height="410" width="500" x="1640" y="130" as="geometry" />
        </mxCell>
        <mxCell id="tech-ts-update" parent="tech-ts-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;5. 真实曝光后更新后验&lt;/b&gt;&lt;br&gt;只有真正进入可视区才开始记账；等待反馈观察窗结束后得到二元奖励 r：&lt;br&gt;r=1：点击/有效长停留/点赞收藏评论等正反馈&lt;br&gt;r=0：有效曝光后无正反馈或明确负反馈&lt;br&gt;&lt;br&gt;α_i ← α_i + r&lt;br&gt;β_i ← β_i + (1−r)&lt;br&gt;&lt;br&gt;同时累计阶段曝光 n_i，交给独立状态机判断是否晋级。" vertex="1">
          <mxGeometry height="410" width="500" x="2180" y="130" as="geometry" />
        </mxCell>
        <mxCell id="tech-ts-note" parent="tech-ts-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontColor=#312E81;fontSize=12;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;" value="&lt;b&gt;职责边界&lt;/b&gt;　Thompson Sampling只决定“本次请求的冷内容槽位选谁”；阶段状态机根据累计曝光、Beta后验、同类目基准和负反馈决定“S0→S1→S2或退出”。w_m / w_θ / w_g / w_s、先验强度与奖励口径必须记录bandit_version并通过离线回放与在线实验校准。" vertex="1">
          <mxGeometry height="120" width="2640" x="130" y="590" as="geometry" />
        </mxCell>
        <mxCell id="tech-ts-e-12" edge="1" parent="tech-ts-1" source="tech-ts-prior" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#EC4899;strokeWidth=2;" target="tech-ts-sample" value="Beta后验">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-ts-e-23" edge="1" parent="tech-ts-1" source="tech-ts-sample" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#F97316;strokeWidth=2;" target="tech-ts-score" value="θ_i">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-ts-e-34" edge="1" parent="tech-ts-1" source="tech-ts-score" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#F59E0B;strokeWidth=2;" target="tech-ts-select" value="选择分">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-ts-e-45" edge="1" parent="tech-ts-1" source="tech-ts-select" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#10B981;strokeWidth=2;" target="tech-ts-update" value="实际曝光与反馈">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cadence-1" connectable="0" parent="1" style="group;" value="" vertex="1">
          <mxGeometry height="1280" width="2900" x="-160" y="7510" as="geometry" />
        </mxCell>
        <mxCell id="cadence-bg" parent="cadence-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=3;dashed=1;" value="" vertex="1">
          <mxGeometry height="1260" width="2880" x="10" y="5" as="geometry" />
        </mxCell>
        <mxCell id="cadence-title" parent="cadence-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#0F766E;" value="低流量场景：双周温启动全量更新与日常在线更新的时间轴" vertex="1">
          <mxGeometry height="42" width="1900" x="500" y="22" as="geometry" />
        </mxCell>
        <mxCell id="cadence-subtitle" parent="cadence-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#64748B;" value="深度模型每14天或样本阈值触发；周期内不做参数增量训练。Text/Image Encoder长期冻结，UserCF/ItemCF每日重算，实时状态与冷ANN持续更新。" vertex="1">
          <mxGeometry height="32" width="2400" x="250" y="65" as="geometry" />
        </mxCell>
        <mxCell id="cadence-t14" parent="cadence-1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=3;fontColor=#4C1D95;fontSize=14;fontStyle=1;" value="T−14天&lt;br&gt;上一轮训练" vertex="1">
          <mxGeometry height="110" width="110" x="250" y="115" as="geometry" />
        </mxCell>
        <mxCell id="cadence-t7" parent="cadence-1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=3;fontColor=#14532D;fontSize=14;fontStyle=1;" value="T−7天&lt;br&gt;持续积累" vertex="1">
          <mxGeometry height="110" width="110" x="930" y="115" as="geometry" />
        </mxCell>
        <mxCell id="cadence-now" parent="cadence-1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=3;fontColor=#9A3412;fontSize=14;fontStyle=1;" value="T=现在&lt;br&gt;本轮训练" vertex="1">
          <mxGeometry height="110" width="110" x="1780" y="115" as="geometry" />
        </mxCell>
        <mxCell id="cadence-next" parent="cadence-1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=3;fontColor=#1E3A8A;fontSize=14;fontStyle=1;" value="T+14天&lt;br&gt;下一轮检查" vertex="1">
          <mxGeometry height="110" width="110" x="2580" y="115" as="geometry" />
        </mxCell>
        <mxCell id="cadence-e-t14-t7" edge="1" parent="cadence-1" source="cadence-t14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#64748B;strokeWidth=4;fontColor=#334155;" target="cadence-t7" value="7天">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cadence-e-t7-now" edge="1" parent="cadence-1" source="cadence-t7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#64748B;strokeWidth=4;fontColor=#334155;" target="cadence-now" value="再积累7天">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cadence-e-now-next" edge="1" parent="cadence-1" source="cadence-now" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#64748B;strokeWidth=4;fontColor=#334155;" target="cadence-next" value="进入下一观察窗口">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cadence-prev" parent="cadence-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;① T−14天：上一轮发布&lt;/b&gt;&lt;/div&gt;&lt;br&gt;• DropoutNet D_{k−1}&lt;br&gt;• DIN+MMoE Teacher T_{k−1}&lt;br&gt;• DCN Student S_{k−1}&lt;br&gt;• 全量 Item Embedding / ANN 版本 V_{k−1}&lt;br&gt;&lt;br&gt;发布后模型参数在线只读。" vertex="1">
          <mxGeometry height="230" width="520" x="70" y="250" as="geometry" />
        </mxCell>
        <mxCell id="cadence-window" parent="cadence-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;② T−14天 → T−1天：积累新数据&lt;/b&gt;&lt;/div&gt;&lt;br&gt;• 曝光与点击/点赞/收藏/评论/停留&lt;br&gt;• 曝光发生前的用户历史序列&lt;br&gt;• 冷启动阶段、Beta后验与负反馈&lt;br&gt;• Teacher logits / final_score / rank 日志&lt;br&gt;• 新Item内容与属性特征&lt;br&gt;&lt;br&gt;仅积累样本和更新在线状态，不反向传播。" vertex="1">
          <mxGeometry height="230" width="680" x="630" y="250" as="geometry" />
        </mxCell>
        <mxCell id="cadence-dataset" parent="cadence-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;③ T=现在：构造本轮训练集&lt;/b&gt;&lt;/div&gt;&lt;br&gt;D_k = D_recent(最近14天)&lt;br&gt;　　∪ Sample(D_history)&lt;br&gt;&lt;br&gt;历史样本按时间衰减：&lt;br&gt;w(age)=2^(−age/H)&lt;br&gt;&lt;br&gt;去重、异常流量过滤、长尾分层抽样；按时间切分 Train / Validation，禁止未来行为泄漏。" vertex="1">
          <mxGeometry height="230" width="600" x="1350" y="250" as="geometry" />
        </mxCell>
        <mxCell id="cadence-train-seq" parent="cadence-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;④ T=现在：温启动训练顺序&lt;/b&gt;&lt;/div&gt;&lt;br&gt;1. 加载 D_{k−1}，训练 DropoutNet D_k&lt;br&gt;2. 加载 T_{k−1}，联合训练 DIN+MMoE 得到 T_k&lt;br&gt;3. 用 T_k 对蒸馏样本离线打分&lt;br&gt;4. 加载 S_{k−1}，蒸馏 DCN 得到 S_k&lt;br&gt;5. 各模型1～2 epoch + Early Stopping&lt;br&gt;&lt;br&gt;验证未提升的模型保持上一稳定版本。" vertex="1">
          <mxGeometry height="230" width="790" x="1990" y="250" as="geometry" />
        </mxCell>
        <mxCell id="cadence-daily-lane" parent="cadence-1" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#EFF6FF;swimlaneFillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontStyle=1;fontSize=15;" value="每日计算通道（连续执行14次，与深度模型训练解耦）" vertex="1">
          <mxGeometry height="150" width="2710" x="70" y="510" as="geometry" />
        </mxCell>
        <mxCell id="cadence-daily-cf" parent="cadence-daily-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#60A5FA;fontColor=#1E3A8A;fontSize=13;align=left;spacingLeft=14;" value="&lt;b&gt;每天固定任务&lt;/b&gt;　重算UserCF / ItemCF；按Item汇总真实曝光和点击，计算exposure/click/ctr（1d/7d/30d），生成带feature_time/version的每日快照并发布到在线Item Feature Store。" vertex="1">
          <mxGeometry height="82" width="1280" x="30" y="52" as="geometry" />
        </mxCell>
        <mxCell id="cadence-daily-ticks" parent="cadence-daily-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1D4ED8;fontSize=13;fontStyle=1;" value="Day 1　Day 2　Day 3　…　Day 7　…　Day 13　Day 14&lt;br&gt;CF每日更新；深度模型参数保持不变" vertex="1">
          <mxGeometry height="82" width="1300" x="1360" y="52" as="geometry" />
        </mxCell>
        <mxCell id="cadence-realtime-lane" parent="cadence-1" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#F0FDF4;swimlaneFillColor=#FFFFFF;strokeColor=#10B981;fontColor=#14532D;fontStyle=1;fontSize=15;" value="实时在线通道（不训练模型参数）" vertex="1">
          <mxGeometry height="175" width="2710" x="70" y="690" as="geometry" />
        </mxCell>
        <mxCell id="cadence-realtime-state" parent="cadence-realtime-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#34D399;fontColor=#14532D;fontSize=12;align=left;spacingLeft=12;" value="&lt;b&gt;实时特征/状态&lt;/b&gt;&lt;br&gt;session行为序列、曝光桶、Beta(α,β)、S0/S1/S2、阶段曝光进度与dynamic boost" vertex="1">
          <mxGeometry height="105" width="760" x="30" y="52" as="geometry" />
        </mxCell>
        <mxCell id="cadence-realtime-item" parent="cadence-realtime-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#14532D;fontSize=12;align=left;spacingLeft=12;" value="&lt;b&gt;新Item实时进入冷召回&lt;/b&gt;&lt;br&gt;冻结Text/Image Encoder → 当前Item Tower/DropoutNet前向计算 → Item Embedding → 增量写入冷ANN" vertex="1">
          <mxGeometry height="105" width="920" x="830" y="52" as="geometry" />
        </mxCell>
        <mxCell id="cadence-realtime-rule" parent="cadence-realtime-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;align=left;spacingLeft=12;" value="&lt;b&gt;明确不做&lt;/b&gt;&lt;br&gt;不做分钟级/小时级反向传播；不在线更新User ID Embedding；不因单个小批次发布新深度模型版本。" vertex="1">
          <mxGeometry height="105" width="850" x="1800" y="52" as="geometry" />
        </mxCell>
        <mxCell id="cadence-dropout" parent="cadence-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;div style=&quot;text-align:center;font-size:15px&quot;&gt;&lt;b&gt;DropoutNet（双周）&lt;/b&gt;&lt;/div&gt;&lt;br&gt;D_{k−1} → D_k&lt;br&gt;最近14天成熟Item交互 + 历史衰减回放&lt;br&gt;训练时模拟缺失Item ID/行为/图像模态&lt;br&gt;&lt;br&gt;发布后重算冷Item表示与冷ANN。" vertex="1">
          <mxGeometry height="235" width="500" x="70" y="900" as="geometry" />
        </mxCell>
        <mxCell id="cadence-teacher" parent="cadence-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;div style=&quot;text-align:center;font-size:15px&quot;&gt;&lt;b&gt;DIN + MMoE Teacher（双周）&lt;/b&gt;&lt;/div&gt;&lt;br&gt;T_{k−1} → T_k&lt;br&gt;最近14天真实曝光反馈 + 历史衰减回放&lt;br&gt;DIN与MMoE端到端联合训练&lt;br&gt;按各任务AUC/LogLoss/回归误差和概率校准验证。" vertex="1">
          <mxGeometry height="235" width="570" x="610" y="900" as="geometry" />
        </mxCell>
        <mxCell id="cadence-dcn" parent="cadence-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;div style=&quot;text-align:center;font-size:15px&quot;&gt;&lt;b&gt;DCN Student（双周）&lt;/b&gt;&lt;/div&gt;&lt;br&gt;先得到本轮 T_k，再由 T_k 离线打分蒸馏样本&lt;br&gt;S_{k−1} → S_k&lt;br&gt;MSE软分 + Pair/List排序 + 可选Hard Label&lt;br&gt;验证NDCG、Teacher一致性、Top-500保留率和延迟。" vertex="1">
          <mxGeometry height="235" width="570" x="1220" y="900" as="geometry" />
        </mxCell>
        <mxCell id="cadence-encoders" parent="cadence-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;div style=&quot;text-align:center;font-size:15px&quot;&gt;&lt;b&gt;Text / Image Encoder&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;长期冻结，不参与双周反向传播&lt;/b&gt;&lt;br&gt;仅执行前向编码；只有模态、语料或效果明显漂移时单独立项更新，并重新生成全量内容向量。" vertex="1">
          <mxGeometry height="235" width="440" x="1830" y="900" as="geometry" />
        </mxCell>
        <mxCell id="cadence-release" parent="cadence-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;" value="&lt;div style=&quot;text-align:center;font-size:15px&quot;&gt;&lt;b&gt;验证与发布&lt;/b&gt;&lt;/div&gt;&lt;br&gt;通过才发布 D_k / T_k / S_k&lt;br&gt;失败模型沿用上一版本&lt;br&gt;记录训练窗口、样本口径、Encoder/Feature/Model/Index版本&lt;br&gt;&lt;br&gt;随后进入下一14天周期。" vertex="1">
          <mxGeometry height="235" width="470" x="2310" y="900" as="geometry" />
        </mxCell>
        <mxCell id="cadence-e-teacher-dcn" edge="1" parent="cadence-1" source="cadence-teacher" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#F97316;strokeWidth=2;fontColor=#C2410C;" target="cadence-dcn" value="T_k离线打分">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cadence-note" parent="cadence-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#78350F;fontSize=12;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;" value="&lt;b&gt;触发规则&lt;/b&gt;　默认每14天检查一次；若有效样本量或各任务正样本不足，则延后并继续累计；若达到预设样本阈值或出现显著数据漂移，可提前触发。这里的“全量更新”表示温启动更新全部可训练参数，并在发布后重算受影响的全量Item Embedding/ANN，不表示从随机参数使用全部历史数据重训。" vertex="1">
          <mxGeometry height="88" width="2710" x="70" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="uc-1" connectable="0" parent="1" style="group;" value="" vertex="1" visible="0">
          <mxGeometry height="1290" width="2900" x="-160" y="8840" as="geometry" />
